{
  "kind": "interpretation-profile",
  "contractVersion": "1.1.0",
  "id": "synthetic/kepware-like/profile",
  "version": "1.0.0",
  "body": {
    "interpreter": {
      "name": "synthetic-kepware-like-interpreter",
      "version": "0.1.0",
      "implementationDigest": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    "supports": [
      {
        "product": "synthetic-kepware-like",
        "versions": [
          "1"
        ],
        "drivers": [
          "synthetic-driver"
        ],
        "inputFormats": [
          "synthetic-json-project"
        ],
        "patterns": [
          "linear scaling",
          "tag reference by name"
        ]
      }
    ],
    "unknownVersionPolicy": "reject",
    "rules": [
      {
        "ruleId": "synthetic-kepware-like.linear-scaling",
        "version": "1.0.0",
        "summary": "eng = engLow + (raw - rawLow) * (engHigh - engLow) / (rawHigh - rawLow)"
      },
      {
        "ruleId": "synthetic-kepware-like.reference-by-name",
        "version": "1.0.0",
        "summary": "a dotted name resolves from the channel; a bare name matches any tag of that name"
      },
      {
        "ruleId": "synthetic-kepware-like.plain-tag-state",
        "version": "1.0.0",
        "summary": "a tag with an address and linear scaling and no expression keeps no state"
      }
    ],
    "limits": {
      "maxArtifacts": 10,
      "maxTotalBytes": 10485760,
      "maxReferenceDepth": 16,
      "maxNodes": 100000
    },
    "knownGaps": [
      "a bare-name reference that matches more than one tag is left ambiguous, never chosen"
    ]
  },
  "digest": "c976bb135f85ccaa4a7ae9c7b9449978ec86f9bafe2149b81e4b6e2fa4d0b871"
