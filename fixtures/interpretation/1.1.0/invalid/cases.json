{
  "about": "Cases for contract 1.1.0. Each case loads a valid 1.1.0 fixture (or, where a companion names a version, a fixture of that version), applies the edits, optionally re-stamps the digest, and checks it. expect is the violation code, or null for a case that must pass.",
  "cases": [
    {
      "name": "edge-without-access",
      "base": "pio-like",
      "file": "interpretation-snapshot.json",
      "mode": "single",
      "restamp": true,
      "edits": [
        {
          "op": "remove",
          "path": "/body/referenceEdges/0/access"
        }
      ],
      "expect": "contract.schema"
    },
    {
      "name": "contains-edge-with-access",
      "base": "kepware-like",
      "file": "interpretation-snapshot.json",
      "mode": "single",
      "restamp": true,
      "edits": [
        {
          "op": "set",
          "path": "/body/referenceEdges/0/access",
          "value": "read"
        }
      ],
      "expect": "contract.schema"
    },
    {
