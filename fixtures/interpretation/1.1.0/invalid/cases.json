      "file": "interpretation-snapshot.json",
      "mode": "single",
      "restamp": true,
      "edits": [
        {
          "op": "set",
          "path": "/body/referenceEdges/4/access",
          "value": "read-write"
        }
      ],
      "expect": "contract.schema"
    },
    {
      "name": "access-unknown-is-allowed",
      "base": "pio-like",
      "file": "interpretation-snapshot.json",
      "mode": "single",
      "restamp": true,
      "edits": [
        {
          "op": "set",
          "path": "/body/referenceEdges/0/access",
          "value": "unknown"
        }
      ],
      "expect": null
